---
// Component chuyển đổi chế độ giảm hiệu ứng chuyển động
---

<button
  type="button"
  id="motion-toggle-btn"
  class="motion-toggle"
  aria-label="Chuyển đổi hiệu ứng chuyển động"
  title="Bật/Tắt giảm hiệu ứng chuyển động"
>
  <span class="motion-icon" aria-hidden="true">
    <svg class="icon-wind" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/>
      <path d="M9.6 4.6A2 2 0 1 1 11 8H2"/>
      <path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>
    </svg>
    <svg class="icon-still" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
      <circle cx="12" cy="12" r="9"/>
      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
    </svg>
  </span>
  <span class="motion-text">Hiệu ứng</span>
</button>

<style>
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
    font-family: var(--font-body);
    color: var(--color-mist-300);
    background: rgba(24, 35, 31, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    min-height: 40px;
  }

  .motion-toggle:hover {
    color: var(--color-gold-300);
    border-color: var(--border-gold);
    background: var(--color-ink-700);
  }

  .motion-icon {
    display: flex;
    align-items: center;
  }

  /* Khi chế độ giảm hiệu ứng được bật */
  :global([data-reduced-motion="true"]) .icon-wind {
    display: none !important;
  }

  :global([data-reduced-motion="true"]) .icon-still {
    display: block !important;
  }

  :global([data-reduced-motion="true"]) #motion-toggle-btn {
    border-color: var(--color-gold-400);
    color: var(--color-gold-300);
  }
</style>

<script>
  function initMotionToggle() {
    const btn = document.getElementById('motion-toggle-btn');
    if (!btn) return;

    // Kiểm tra cài đặt đã lưu trong localStorage hoặc media query hệ điều hành
    const saved = localStorage.getItem('kiemhiep-reduced-motion');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isReduced = saved !== null ? saved === 'true' : prefersReduced;

    if (isReduced) {
      document.documentElement.setAttribute('data-reduced-motion', 'true');
    } else {
      document.documentElement.removeAttribute('data-reduced-motion');
    }

    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-reduced-motion') === 'true';
      const next = !current;

      if (next) {
        document.documentElement.setAttribute('data-reduced-motion', 'true');
        localStorage.setItem('kiemhiep-reduced-motion', 'true');
      } else {
        document.documentElement.removeAttribute('data-reduced-motion');
        localStorage.setItem('kiemhiep-reduced-motion', 'false');
      }
    });
  }

  // Khởi chạy khi DOM sẵn sàng
  initMotionToggle();
  document.addEventListener('astro:page-load', initMotionToggle);
</script>
