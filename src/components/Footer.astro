---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/urls';

const currentYear = 2026;
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-inner">
    <!-- Nét cọ phân chia -->
    <div class="brush-separator" aria-hidden="true"></div>

    <div class="footer-grid">
      <!-- Cột 1: Giới thiệu & Triện ấn -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <span class="seal-mark" aria-hidden="true">義</span>
          <span class="footer-title">{siteConfig.author.displayName}</span>
        </div>
        <p class="footer-bio">
          {siteConfig.author.bio}
        </p>
        <p class="footer-motto">
          <em>“Gươm bén trong tay, tâm bền nơi dạ. Mã nguồn chuẩn mực, vạn dặm thong dong.”</em>
        </p>
      </div>

      <!-- Cột 2: Điều hướng nhanh -->
      <div class="footer-col nav-col">
        <h3 class="footer-heading">Chỉ Lộ Giang Hồ</h3>
        <ul class="footer-links">
          {siteConfig.nav.map((item) => (
            <li>
              <a href={withBase(item.path)}>{item.label}</a>
            </li>
          ))}
          <li>
            <a href={withBase('/rss.xml')} target="_blank" rel="noopener">RSS Bút Ký</a>
          </li>
        </ul>
      </div>

      <!-- Cột 3: Kết nối & Mã nguồn -->
      <div class="footer-col social-col">
        <h3 class="footer-heading">Kỳ Ngộ</h3>
        <p class="footer-social-desc">
          Rất vui được kết giao cùng các đạo hữu trong chốn công nghệ.
        </p>
        <div class="social-links">
          {siteConfig.author.socials.github && (
            <a
              href={siteConfig.author.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="social-btn"
              aria-label="GitHub của Arthur Heisenberg"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              <span>GitHub</span>
            </a>
          )}
          <a
            href={withBase('/contact/')}
            class="social-btn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>Thư từ</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bản quyền -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {siteConfig.author.fullName} ({siteConfig.author.displayName}). Xây dựng tĩnh với Astro &amp; GitHub Pages.
      </p>
      <p class="theme-credit">
        Lấy cảm hứng từ không khí kiếm hiệp sơn thủy <em>Where Winds Meet</em>.
      </p>
    </div>
  </div>

  <!-- Nút Trở về đỉnh núi (Back to top) -->
  <button
    type="button"
    id="back-to-top"
    aria-label="Cuộn về đầu trang"
    title="Trở về đầu trang"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</footer>

<style>
  .site-footer {
    background-color: rgba(10, 16, 13, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
    padding-bottom: 3.5rem;
    margin-top: auto;
    position: relative;
    z-index: 10;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-paper-50);
    font-weight: 600;
  }

  .footer-bio {
    font-size: 0.9375rem;
    color: var(--color-mist-300);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .footer-motto {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    color: var(--color-gold-400);
    line-height: 1.6;
    margin: 0;
  }

  .footer-heading {
    font-size: 1rem;
    color: var(--color-paper-50);
    font-family: var(--font-heading);
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-gold-400);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: var(--color-mist-300);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--transition-fast), padding-left var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-gold-300);
    padding-left: 4px;
  }

  .footer-social-desc {
    font-size: 0.9375rem;
    color: var(--color-mist-300);
    margin-bottom: 1rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--color-ink-800);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-paper-100);
    font-size: 0.875rem;
    text-decoration: none;
    min-height: 44px;
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    background: var(--color-ink-700);
    border-color: var(--color-gold-400);
    color: var(--color-gold-300);
    transform: translateY(-2px);
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(200, 211, 202, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-mist-500);
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    function onScroll() {
      if (window.scrollY > 400) {
        btn?.classList.add('is-visible');
      } else {
        btn?.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    btn.addEventListener('click', () => {
      const prefersReduced = document.documentElement.getAttribute('data-reduced-motion') === 'true' ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      window.scrollTo({
        top: 0,
        behavior: prefersReduced ? 'auto' : 'smooth',
      });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
