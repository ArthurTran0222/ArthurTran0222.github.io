---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/urls';
---

<BaseLayout
  title="Lạc Giữa Giang Hồ (404)"
  description="Đường mòn sương khói mịt mù, không tìm thấy trang bạn yêu cầu."
>
  <div class="not-found-page">
    <div class="container not-found-container">
      <div class="not-found-card reveal-on-scroll">
        <span class="not-found-seal" aria-hidden="true">迷</span>

        <h1 class="not-found-code">404</h1>
        <h2 class="not-found-title">Lạc Giữa Giang Hồ</h2>

        <p class="not-found-desc">
          Lối mòn xưa đã bị sương khói che khuất, hoặc trang đạo hữu tìm kiếm đã dời bước tới chốn khác.
        </p>

        <div class="brush-separator" aria-hidden="true"></div>

        <div class="not-found-actions">
          <a href={withBase('/')} class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Trở về Trang chủ</span>
          </a>

          <a href={withBase('/posts/')} class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span>Đọc Bút ký giang hồ</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .not-found-container {
    display: flex;
    justify-content: center;
  }

  .not-found-card {
    max-width: 620px;
    width: 100%;
    text-align: center;
    padding: 3.5rem 2rem;
    background: rgba(24, 35, 31, 0.7);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
  }

  .not-found-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--color-cinnabar-500);
    color: #ffffff;
    font-size: 1.75rem;
    font-family: var(--font-heading);
    font-weight: 700;
    border-radius: 4px;
    box-shadow: var(--shadow-cinnabar);
    margin-bottom: 1.25rem;
  }

  .not-found-code {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    line-height: 1;
    margin: 0 0 0.5rem 0;
    color: var(--color-gold-300);
    letter-spacing: 0.05em;
  }

  .not-found-title {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--color-paper-50);
    margin: 0 0 1rem 0;
  }

  .not-found-desc {
    font-size: 1.1rem;
    color: var(--color-mist-300);
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
  }

  .not-found-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
