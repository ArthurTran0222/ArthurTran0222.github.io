---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const hasEmail = Boolean(siteConfig.author.email && siteConfig.author.email.trim() !== '');
const hasGithub = Boolean(siteConfig.author.socials.github);
---

<BaseLayout
  title="Liên Hệ & Kết Giao"
  description={`Thông tin liên hệ, kết nối cùng ${siteConfig.author.fullName} (${siteConfig.author.displayName}).`}
>
  <div class="contact-page">
    <div class="container container-prose">
      <header class="page-header reveal-on-scroll">
        <span class="seal-mark" aria-hidden="true">信</span>
        <h1 class="page-title">Hữu Duyên Tương Ngộ</h1>
        <p class="page-lead">
          Nơi giao lưu, trao đổi học thuật công nghệ và kết nối giữa những người bạn cùng chung chí hướng.
        </p>
      </header>

      <div class="sword-card contact-card reveal-on-scroll">
        <div class="contact-methods">
          <!-- Kênh Email -->
          <div class="contact-item">
            <div class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="contact-detail">
              <h2 class="contact-title">Thư Điện Tử (Email)</h2>
              {hasEmail ? (
                <a href={`mailto:${siteConfig.author.email}`} class="contact-link">
                  {siteConfig.author.email}
                </a>
              ) : (
                <div class="email-config-note">
                  <p class="note-status">
                    <em>(Chưa cấu hình địa chỉ email công khai)</em>
                  </p>
                  <p class="note-guide">
                    ⚙️ <strong>Dành cho chủ trang:</strong> Vui lòng mở file <code>src/config/site.ts</code> và điền địa chỉ email thật của bạn vào trường <code>author.email</code> để kích hoạt liên kết gửi thư.
                  </p>
                </div>
              )}
            </div>
          </div>

          <!-- Kênh GitHub -->
          {hasGithub && (
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </div>
              <div class="contact-detail">
                <h2 class="contact-title">Mã Nguồn GitHub</h2>
                <a
                  href={siteConfig.author.socials.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-link"
                >
                  {siteConfig.author.socials.github}
                </a>
                <p class="contact-subtext">Kho lưu trữ các dự án cá nhân và mã nguồn mở.</p>
              </div>
            </div>
          )}

          <!-- Vị trí địa lý -->
          <div class="contact-item">
            <div class="contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="contact-detail">
              <h2 class="contact-title">Địa Điểm</h2>
              <p class="contact-text">{siteConfig.author.location}</p>
              <p class="contact-subtext">Sẵn sàng hợp tác từ xa (Remote) hoặc trao đổi trực tiếp.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 0.75rem 0;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--color-mist-300);
    margin: 0;
    line-height: 1.7;
  }

  .contact-card {
    padding: 2.5rem;
    border-color: var(--border-gold);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .contact-icon {
    width: 50px;
    height: 50px;
    background: rgba(24, 35, 31, 0.9);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-sm);
    color: var(--color-gold-300);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-detail {
    flex-grow: 1;
  }

  .contact-title {
    font-size: 1.25rem;
    color: var(--color-paper-50);
    margin: 0 0 0.35rem 0;
  }

  .contact-link {
    font-size: 1.05rem;
    color: var(--color-gold-300);
    text-decoration: none;
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--color-paper-50);
    text-decoration: underline;
  }

  .contact-text {
    font-size: 1.05rem;
    color: var(--color-paper-100);
    margin: 0;
  }

  .contact-subtext {
    font-size: 0.875rem;
    color: var(--color-mist-300);
    margin: 0.35rem 0 0 0;
  }

  .email-config-note {
    background: rgba(17, 25, 22, 0.7);
    border-left: 3px solid var(--color-gold-400);
    padding: 0.85rem 1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: 0.5rem;
  }

  .note-status {
    color: var(--color-mist-300);
    font-size: 0.9rem;
    margin: 0 0 0.4rem 0;
  }

  .note-guide {
    color: var(--color-paper-200);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .contact-card {
      padding: 1.5rem;
    }

    .contact-item {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
