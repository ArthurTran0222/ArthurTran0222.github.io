---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPublishedProjects } from '../../utils/content';

const allProjects = await getCollection('projects');
const publishedProjects = getPublishedProjects(allProjects);

// Lấy danh sách toàn bộ tags công nghệ
const allTags = Array.from(
  new Set(publishedProjects.flatMap((p) => p.data.tags || []))
).sort();
---

<BaseLayout
  title="Tác Phẩm & Dự Án"
  description="Danh sách các dự án phần mềm, kiến trúc hệ thống và giao diện người dùng được xây dựng theo phong cách kiếm hiệp hiện đại."
>
  <div class="projects-page">
    <div class="container">
      <header class="page-header reveal-on-scroll">
        <span class="seal-mark" aria-hidden="true">劍</span>
        <h1 class="page-title">Kho Tàng Tác Phẩm</h1>
        <p class="page-lead">
          Nơi lưu giữ các dự án đã tôi luyện, từ kiến trúc Clean Code đến hệ thống giao diện chuẩn mực.
        </p>
      </header>

      <!-- Danh sách bộ lọc tags (Client filter) -->
      {allTags.length > 0 && (
        <div class="project-filters reveal-on-scroll" id="project-filter-bar">
          <span class="filter-label">Lọc theo võ học:</span>
          <button type="button" class="filter-tag active" data-filter="all">Tất cả ({publishedProjects.length})</button>
          {allTags.map((tag) => (
            <button type="button" class="filter-tag" data-filter={tag}>#{tag}</button>
          ))}
        </div>
      )}

      <!-- Lưới hiển thị dự án -->
      <div class="projects-grid" id="projects-grid">
        {publishedProjects.map((project) => (
          <div class="project-item" data-tags={JSON.stringify(project.data.tags || [])}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <!-- Trạng thái không có kết quả -->
      <div class="no-results" id="no-projects-msg" style="display: none;">
        <span class="no-results-seal" aria-hidden="true">空</span>
        <h3 class="no-results-title">Không tìm thấy tác phẩm</h3>
        <p class="no-results-desc">Không có tác phẩm nào phù hợp với bộ lọc hiện tại.</p>
        <button type="button" class="btn btn-secondary" id="reset-filter-btn">Xem tất cả tác phẩm</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 0.75rem 0;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--color-mist-300);
    max-width: 680px;
    margin: 0;
    line-height: 1.7;
  }

  .project-filters {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    padding: 1rem;
    background: rgba(24, 35, 31, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .filter-label {
    font-size: 0.875rem;
    color: var(--color-gold-400);
    font-family: var(--font-heading);
    margin-right: 0.5rem;
  }

  .filter-tag {
    background: transparent;
    color: var(--color-mist-300);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-body);
    transition: all var(--transition-fast);
  }

  .filter-tag:hover,
  .filter-tag.active {
    background: rgba(181, 154, 99, 0.2);
    color: var(--color-gold-300);
    border-color: var(--color-gold-400);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1.5rem;
    background: rgba(24, 35, 31, 0.5);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    margin-top: 2rem;
  }

  .no-results-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-ink-700);
    color: var(--color-mist-500);
    font-size: 1.5rem;
    font-family: var(--font-heading);
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .no-results-title {
    font-size: 1.4rem;
    color: var(--color-paper-50);
    margin: 0 0 0.5rem 0;
  }

  .no-results-desc {
    font-size: 0.95rem;
    color: var(--color-mist-300);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupProjectFiltering() {
    const filterButtons = document.querySelectorAll('.filter-tag');
    const items = document.querySelectorAll<HTMLElement>('.project-item');
    const noResults = document.getElementById('no-projects-msg');
    const resetBtn = document.getElementById('reset-filter-btn');

    if (!filterButtons.length) return;

    function applyFilter(selectedTag: string) {
      let visibleCount = 0;

      items.forEach((item) => {
        if (selectedTag === 'all') {
          item.style.display = 'block';
          visibleCount++;
        } else {
          const itemTags: string[] = JSON.parse(item.getAttribute('data-tags') || '[]');
          if (itemTags.includes(selectedTag)) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter') || 'all';
        applyFilter(filter);
      });
    });

    resetBtn?.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      document.querySelector('.filter-tag[data-filter="all"]')?.classList.add('active');
      applyFilter('all');
    });
  }

  setupProjectFiltering();
  document.addEventListener('astro:page-load', setupProjectFiltering);
</script>
