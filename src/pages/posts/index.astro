---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../utils/urls';
import { getPublishedPosts, getAllTags } from '../../utils/content';

const allPosts = await getCollection('posts');
const publishedPosts = getPublishedPosts(allPosts);
const tagCounts = getAllTags(publishedPosts);
---

<BaseLayout
  title="Bút Ký Giang Hồ"
  description="Nơi lưu giữ các bài viết chuyên sâu về kỹ thuật lập trình, tối ưu web tĩnh và triết lý làm phần mềm."
>
  <div class="posts-page">
    <div class="container">
      <header class="page-header reveal-on-scroll">
        <span class="seal-mark" aria-hidden="true">墨</span>
        <h1 class="page-title">Bút Ký Giang Hồ</h1>
        <p class="page-lead">
          Ghi chép tâm đắc, chia sẻ kinh nghiệm rèn luyện mã nguồn và triết lý lập trình tĩnh.
        </p>
      </header>

      <!-- Thanh công cụ: Tìm kiếm & Lọc Tags -->
      <div class="posts-toolbar reveal-on-scroll">
        <!-- Ô tìm kiếm bài viết -->
        <div class="search-box-wrap">
          <label for="post-search-input" class="visually-hidden">Tìm kiếm bài viết...</label>
          <div class="search-input-inner">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="post-search-input"
              class="search-input"
              placeholder="Tìm theo tiêu đề, nội dung, kiếm pháp..."
              autocomplete="off"
            />
            <button type="button" id="clear-search-btn" class="clear-search-btn" aria-label="Xóa nội dung tìm kiếm" style="display: none;">
              ✕
            </button>
          </div>
        </div>

        <!-- Mây thẻ tags (Tag cloud) -->
        {tagCounts.length > 0 && (
          <div class="tag-cloud">
            <span class="tag-cloud-label">Chủ đề:</span>
            {tagCounts.map(({ tag, count }) => (
              <a href={withBase(`/tags/${tag}/`)} class="tag-badge">
                #{tag} <span class="tag-count">({count})</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Lưới bài viết tĩnh ban đầu -->
      <div class="posts-grid" id="posts-grid">
        {publishedPosts.map((post) => (
          <div
            class="post-card-item"
            data-title={post.data.title}
            data-desc={post.data.description}
            data-tags={JSON.stringify(post.data.tags || [])}
          >
            <PostCard post={post} />
          </div>
        ))}
      </div>

      <!-- Trạng thái không có kết quả tìm kiếm -->
      <div class="no-results" id="no-posts-found" style="display: none;">
        <span class="no-results-seal" aria-hidden="true">無</span>
        <h3 class="no-results-title">Không tìm thấy bút ký nào</h3>
        <p class="no-results-desc">Không có bài viết nào khớp với từ khóa tìm kiếm của bạn.</p>
        <button type="button" class="btn btn-secondary" id="reset-search-btn">
          Xóa tìm kiếm &amp; Hiện tất cả bài viết
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .posts-page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 0.75rem 0;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--color-mist-300);
    max-width: 680px;
    margin: 0;
    line-height: 1.7;
  }

  .posts-toolbar {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .search-box-wrap {
    width: 100%;
    max-width: 580px;
  }

  .search-input-inner {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: var(--color-gold-400);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 2.75rem;
    background: var(--color-ink-800);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-sm);
    color: var(--color-paper-100);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
    transition: all var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--color-gold-300);
    box-shadow: 0 0 12px rgba(181, 154, 99, 0.25);
  }

  .clear-search-btn {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: var(--color-mist-300);
    font-size: 1.1rem;
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .clear-search-btn:hover {
    color: var(--color-paper-50);
    background: rgba(200, 211, 202, 0.1);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .tag-cloud-label {
    font-size: 0.875rem;
    color: var(--color-gold-400);
    font-family: var(--font-heading);
    margin-right: 0.5rem;
  }

  .tag-count {
    opacity: 0.75;
    font-size: 0.75em;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1.5rem;
    background: rgba(24, 35, 31, 0.5);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    margin-top: 2rem;
  }

  .no-results-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-ink-700);
    color: var(--color-mist-500);
    font-size: 1.5rem;
    font-family: var(--font-heading);
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .no-results-title {
    font-size: 1.4rem;
    color: var(--color-paper-50);
    margin: 0 0 0.5rem 0;
  }

  .no-results-desc {
    font-size: 0.95rem;
    color: var(--color-mist-300);
    margin-bottom: 1.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Script tìm kiếm bài viết trực tiếp, chuẩn hóa tiếng Việt không phân biệt hoa thường / có dấu
  function normalizeSearchText(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[đĐ]/g, 'd')
      .trim();
  }

  function setupPostSearch() {
    const input = document.getElementById('post-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const resetBtn = document.getElementById('reset-search-btn');
    const items = document.querySelectorAll<HTMLElement>('.post-card-item');
    const noResults = document.getElementById('no-posts-found');

    if (!input || !items.length) return;

    function doSearch(keyword: string) {
      const normalizedQuery = normalizeSearchText(keyword);

      if (clearBtn) {
        clearBtn.style.display = keyword ? 'flex' : 'none';
      }

      let matchCount = 0;

      items.forEach((item) => {
        if (!normalizedQuery) {
          item.style.display = 'block';
          matchCount++;
          return;
        }

        const title = normalizeSearchText(item.getAttribute('data-title') || '');
        const desc = normalizeSearchText(item.getAttribute('data-desc') || '');
        const tags: string[] = JSON.parse(item.getAttribute('data-tags') || '[]');
        const normalizedTags = tags.map(normalizeSearchText).join(' ');

        if (
          title.includes(normalizedQuery) ||
          desc.includes(normalizedQuery) ||
          normalizedTags.includes(normalizedQuery)
        ) {
          item.style.display = 'block';
          matchCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = matchCount === 0 ? 'block' : 'none';
      }
    }

    input.addEventListener('input', () => {
      doSearch(input.value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      doSearch('');
    });

    resetBtn?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      doSearch('');
    });
  }

  setupPostSearch();
  document.addEventListener('astro:page-load', setupPostSearch);
</script>
