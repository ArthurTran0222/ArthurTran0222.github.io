---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostCard from '../components/PostCard.astro';
import { withBase } from '../utils/urls';
import { calculateReadingTime, extractHeadings, slugify } from '../utils/content';

interface Props {
  post: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
}

const { post, relatedPosts } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;

const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate ? new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(updatedDate) : null;

const reading = calculateReadingTime(post.body || '');
const headings = extractHeadings(post.body || '');
---

<BaseLayout
  title={title}
  description={description}
  image={cover || '/images/posts/post-cover-1.svg'}
  article={true}
>
  <!-- Thanh đo tiến độ đọc trên đỉnh màn hình -->
  <div id="reading-progress" aria-hidden="true"></div>

  <article class="post-detail-article">
    <!-- Header bài viết -->
    <header class="post-header">
      <div class="container container-prose">
        <!-- Đường dẫn quay lại danh sách -->
        <a href={withBase('/posts/')} class="back-nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Trở về Bút ký giang hồ</span>
        </a>

        <!-- Tags -->
        <div class="post-tags-top">
          {tags.map((tag: string) => (
            <a href={withBase(`/tags/${slugify(tag)}/`)} class="tag-badge">
              #{tag}
            </a>
          ))}
        </div>

        <h1 class="post-main-title">{title}</h1>

        <p class="post-main-desc">{description}</p>

        <!-- Thông tin metadata bài viết -->
        <div class="post-main-meta">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Khởi bút: <time datetime={pubDate.toISOString()}>{formattedDate}</time></span>
          </div>

          {formattedUpdatedDate && (
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
                <path d="M16 21h5v-5"></path>
              </svg>
              <span>Nhuận bút: <time datetime={updatedDate?.toISOString()}>{formattedUpdatedDate}</time></span>
            </div>
          )}

          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{reading.text}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Ảnh bìa bài viết nếu có -->
    {cover && (
      <div class="container container-prose post-cover-container">
        <div class="post-cover-wrapper">
          <img
            src={withBase(cover)}
            alt={coverAlt || title}
            class="post-detail-cover"
            loading="eager"
            width="800"
            height="450"
          />
        </div>
      </div>
    )}

    <!-- Nội dung chính & Mục lục -->
    <div class="container container-prose post-body-container">
      <!-- Mục lục bài viết -->
      {headings.length > 0 && <TableOfContents headings={headings} />}

      <!-- Markdown Prose Slot -->
      <div class="markdown-prose" id="markdown-content">
        <slot />
      </div>

      <!-- Cuối bài: Lời đề tặng phong cách kiếm hiệp -->
      <div class="post-end-signature">
        <div class="seal-mark" aria-hidden="true">義</div>
        <div class="signature-text">
          <p class="sig-name">Arthur Heisenberg (Trần Trọng Nghĩa)</p>
          <p class="sig-note">Bút ký hoàn tất nơi thư phòng. Cảm ơn đạo hữu đã ghé đọc.</p>
        </div>
      </div>
    </div>
  </article>

  <!-- Danh sách bài viết liên quan -->
  {relatedPosts.length > 0 && (
    <section class="related-posts-section">
      <div class="container">
        <div class="brush-separator" aria-hidden="true"></div>
        <h2 class="related-heading">Bút Ký Cùng Đạo</h2>
        <div class="related-grid">
          {relatedPosts.map((relPost) => (
            <PostCard post={relPost} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .post-detail-article {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .back-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-gold-400);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-nav-link:hover {
    color: var(--color-paper-50);
    transform: translateX(-3px);
  }

  .post-tags-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .post-main-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.25;
    margin-bottom: 1rem;
    color: var(--color-paper-50);
  }

  .post-main-desc {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-paper-200);
    margin-bottom: 1.5rem;
  }

  .post-main-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--color-mist-300);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-cover-container {
    margin-bottom: 2.5rem;
  }

  .post-cover-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-elevated);
  }

  .post-detail-cover {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .post-body-container {
    margin-top: 1rem;
  }

  /* Định dạng bài viết Markdown */
  .markdown-prose {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .markdown-prose :global(h2) {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    border-bottom: 1px solid rgba(181, 154, 99, 0.2);
    padding-bottom: 0.5rem;
  }

  .markdown-prose :global(h3) {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .markdown-prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  /* Khung bọc code block với nút Copy */
  .markdown-prose :global(.code-block-wrapper) {
    position: relative;
    margin: 2rem 0;
  }

  .markdown-prose :global(.copy-code-btn) {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-family: var(--font-body);
    background: rgba(24, 35, 31, 0.9);
    color: var(--color-mist-300);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 5;
  }

  .markdown-prose :global(.copy-code-btn:hover) {
    background: var(--color-ink-700);
    color: var(--color-gold-300);
    border-color: var(--border-gold);
  }

  .markdown-prose :global(.copy-code-btn.copied) {
    background: var(--color-cinnabar-500);
    color: #ffffff;
    border-color: var(--color-cinnabar-400);
  }

  .post-end-signature {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding: 1.75rem;
    background: rgba(24, 35, 31, 0.7);
    border: 1px solid rgba(181, 154, 99, 0.3);
    border-radius: var(--radius-md);
  }

  .sig-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-paper-50);
    margin: 0 0 0.25rem 0;
  }

  .sig-note {
    font-size: 0.875rem;
    color: var(--color-mist-300);
    margin: 0;
    font-style: italic;
  }

  /* Related posts */
  .related-posts-section {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  .related-heading {
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: 2.5rem;
    color: var(--color-paper-50);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
</style>

<script>
  // Tự động gắn ID cho các heading H2/H3 và gắn nút Copy Code có thông báo
  function enhanceArticle() {
    const prose = document.getElementById('markdown-content');
    if (!prose) return;

    // 1. Chuẩn hóa ID heading để khớp với TableOfContents
    const headings = prose.querySelectorAll('h2, h3');
    headings.forEach((h) => {
      if (!h.id) {
        const text = h.textContent || '';
        const id = text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .trim()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/[\s_]+/g, '-')
          .replace(/-+/g, '-');
        h.id = id;
      }
    });

    // 2. Thêm nút Copy Code cho tất cả các thẻ <pre>
    const preBlocks = prose.querySelectorAll('pre');
    preBlocks.forEach((pre) => {
      // Tránh gán lặp lại nếu đã có wrapper
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-code-btn';
      copyBtn.setAttribute('aria-label', 'Sao chép đoạn mã');
      copyBtn.textContent = 'Sao chép';

      copyBtn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;

        if (!navigator.clipboard) {
          // Fallback khi Clipboard API không khả dụng
          try {
            const textarea = document.createElement('textarea');
            textarea.value = code;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            copyBtn.textContent = 'Đã chép!';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.textContent = 'Sao chép';
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            copyBtn.textContent = 'Lỗi!';
            setTimeout(() => {
              copyBtn.textContent = 'Sao chép';
            }, 2000);
          }
          return;
        }

        try {
          await navigator.clipboard.writeText(code);
          copyBtn.textContent = 'Đã chép!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.textContent = 'Sao chép';
            copyBtn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          copyBtn.textContent = 'Lỗi!';
          setTimeout(() => {
            copyBtn.textContent = 'Sao chép';
          }, 2000);
        }
      });

      wrapper.appendChild(copyBtn);
    });
  }

  enhanceArticle();
  document.addEventListener('astro:page-load', enhanceArticle);
</script>
